[Unit]
Description=Verified read-only backup of Himoto Supabase data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/himoto-web/runtime.env
ExecStart=/usr/bin/python3 /usr/local/sbin/himoto-web-backup
TimeoutStartSec=10min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/himoto-web
MemoryMax=512M
