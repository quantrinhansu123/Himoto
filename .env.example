# Server-only Supabase transaction pooler URL, copied from Supabase Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@POOLER_HOST:6543/postgres
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGEMENT_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Server-only image extraction. Never use NEXT_PUBLIC_ for this key.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
# Server-only Cloudinary credentials for signed authenticated image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional durable video storage. Browser conversion uses Cloudinary as fallback.
# Apply docs/sql/2026-10-22-cloudfly-videos.sql before enabling cloudfly.
VIDEO_STORAGE_PROVIDER=cloudinary
# Images use CloudFly when VIDEO_STORAGE_PROVIDER=cloudfly unless explicitly overridden.
# Apply docs/sql/2026-11-11-cloudfly-photos.sql before deploying image support.
# PHOTO_STORAGE_PROVIDER=cloudfly
# Historical aliases remain readable independently of the new-upload provider.
# MEDIA_ARCHIVE_ENABLED=on
# CloudFly: browser processing defaults on; set off to use Cloudinary conversion only.
# BROWSER_VIDEO_PROCESSING=off
CLOUDFLY_S3_ENDPOINT=https://s3.cloudfly.vn
CLOUDFLY_S3_REGION=hn
CLOUDFLY_S3_BUCKET=himoto-videos
CLOUDFLY_S3_ACCESS_KEY_ID=
CLOUDFLY_S3_SECRET_ACCESS_KEY=
# Optional custom PEM CA. The public Supabase Root 2021 CA is already included.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# SePay / VietQR: configure demo bank and authenticated webhook
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_ID=
SEPAY_SERVICE_USER_ID=
SEPAY_MODE=test

# Enable only after applying docs/sql/2026-10-31-mobile-sessions.sql.
# Native mobile sessions also require MANAGEMENT_SESSION_SECRET (32+ chars).
HIMOTO_MOBILE_ENABLED=false
