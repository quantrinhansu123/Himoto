# Server-only Supabase transaction pooler URL, copied from Supabase Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@POOLER_HOST:6543/postgres
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGEMENT_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Optional custom PEM CA. The public Supabase Root 2021 CA is already included.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
