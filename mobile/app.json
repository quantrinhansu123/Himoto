{
  "expo": {
    "name": "Himoto",
    "slug": "himoto-staff",
    "version": "1.0.11",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "himoto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.himoto.staff",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "vn.himoto.staff",
      "versionCode": 12,
      "allowBackup": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f928280d-4ea8-4574-b64e-51dd44b94d68",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "./plugins/with-literal-account-input.cjs",
      "./plugins/with-android-release-signing.cjs",
      "expo-updates",
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager/Room instantiate this constructor through reflection.\n-keep class androidx.work.impl.WorkDatabase_Impl { public <init>(); }"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Himoto dùng vị trí hiện tại để xác nhận chấm công khi bạn vào hoặc ra ca."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Himoto dùng Face ID để mở khóa phiên làm việc của bạn."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "himoto-work",
          "color": "#E60019"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Himoto truy cập ảnh bạn chọn để đính kèm bill và hồ sơ công việc.",
          "cameraPermission": "Himoto dùng camera để chụp bill và hồ sơ công việc.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "androidPushConfigured": false,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f928280d-4ea8-4574-b64e-51dd44b94d68"
      }
    },
    "owner": "huybitvvt"
  }
}
